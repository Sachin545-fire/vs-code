{
  "name": "zen-lime-theme",
  "displayName": "Zen Lime Theme",
  "description": "Dark minimal-zen theme with vivid green/lime accents",
  "version": "1.0.0",
  "publisher": "vscode",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Zen Lime",
        "uiTheme": "vs-dark",
        "path": "./zen-lime-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Zen Lime",
      "workbench.iconTheme": "material-icon-theme",
      "workbench.productIconTheme": "fluent-icons",
      "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', Menlo, Monaco, 'Courier New', monospace",
      "editor.fontSize": 14,
      "editor.fontLigatures": true,
      "editor.fontWeight": "400",
      "editor.lineHeight": 1.6,
      "editor.letterSpacing": 0.3,
      "editor.cursorStyle": "line",
      "editor.cursorBlinking": "smooth",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.stickyScroll.enabled": true,
      "editor.padding.top": 8,
      "editor.padding.bottom": 8,
      "editor.lineNumbers": "on",
      "editor.glyphMargin": false,
      "editor.folding": true,
      "editor.foldingStrategy": "indentation",
      "editor.showFoldingControls": "mouseover",
      "editor.overviewRulerBorder": false,
      "editor.renderLineHighlight": "line",
      "editor.renderWhitespace": "none",
      "editor.indentGuides": "light",
      "editor.bracketPairColorization.enabled": true,
      "editor.guides.bracketPairs": "active",
      "editor.guides.bracketPairsHorizontal": "active",
      "editor.guides.highlightActiveIndentation": "always",
      "editor.minimap.enabled": false,
      "editor.minimap.renderCharacters": false,
      "editor.minimap.size": "proportional",
      "editor.codeLens": false,
      "editor.wordWrap": "off",
      "editor.scrollBeyondLastLine": false,
      "editor.scrollBeyondLastColumn": 2,
      "editor.smoothScrolling": true,
      "editor.cursorWidth": 2,
      "editor.suggestSelection": "recentlyUsedByPrefix",
      "editor.suggest.preview": true,
      "editor.suggest.showStatusBar": false,
      "editor.suggest.maxVisibleSuggestions": 10,
      "editor.acceptSuggestionOnCommitCharacter": false,
      "editor.inlineSuggest.enabled": true,
      "editor.inlayHints.enabled": "offUnlessPressed",
      "editor.parameterHints.enabled": true,
      "editor.parameterHints.cycle": true,
      "editor.linkedEditing": true,
      "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": true
      },
      "editor.renderControlCharacters": false,
      "editor.rulers": [],
      "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`~?",
      "editor.selectionHighlight": true,
      "editor.occurrencesHighlight": "multiFile",
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true,
      "editor.formatOnPaste": true,
      "editor.formatOnType": false,
      "editor.autoIndent": "full",
      "editor.tabSize": 2,
      "editor.insertSpaces": true,
      "editor.detectIndentation": true,
      "editor.trimAutoWhitespace": true,
      "editor.stablePeek": false,
      "editor.maxTokenizationLineLength": 20000,
      "workbench.activityBar.location": "default",
      "workbench.sideBar.location": "left",
      "workbench.sideBar.width": 240,
      "workbench.panel.defaultAlignment": "center",
      "workbench.panel.opensMaximized": "never",
      "workbench.editor.showTabs": "multiple",
      "workbench.editor.tabSizing": "fit",
      "workbench.editor.tabSizingFixedMaxWidth": 160,
      "workbench.editor.highlightModifiedTabs": true,
      "workbench.editor.wrapTabs": false,
      "workbench.editor.pinnedTabSizing": "shrink",
      "workbench.editor.enablePreview": true,
      "workbench.editor.enablePreviewFromQuickOpen": true,
      "workbench.editor.revealIfOpen": true,
      "workbench.editor.showIcons": true,
      "workbench.editor.centeredLayoutFixedWidth": 900,
      "workbench.editor.centeredLayoutMaxWidth": 1200,
      "workbench.tips.enabled": false,
      "workbench.startupEditor": "none",
      "workbench.editor.untitled.hint": "hidden",
      "workbench.tree.indent": 12,
      "workbench.tree.renderIndentGuides": "onHover",
      "workbench.list.smoothScrolling": true,
      "workbench.list.defaultHeight": 22,
      "workbench.view.alwaysShowActionBar": false,
      "window.commandCenter": false,
      "window.title": "${activeEditorShort}${separator}${rootName}${separator}${profileName}",
      "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', monospace",
      "terminal.integrated.fontSize": 13,
      "terminal.integrated.lineHeight": 1.3,
      "terminal.integrated.cursorStyle": "line",
      "terminal.integrated.cursorBlinking": true,
      "terminal.integrated.scrollback": 10000,
      "terminal.integrated.smoothScrolling": true,
      "terminal.integrated.enableBell": false,
      "terminal.integrated.defaultProfile.linux": "bash",
      "terminal.integrated.defaultProfile.osx": "zsh",
      "terminal.integrated.defaultProfile.windows": "PowerShell",
      "terminal.integrated.tabs.enabled": true,
      "terminal.integrated.tabs.showActiveTerminal": "single",
      "terminal.integrated.showExitAction": "never",
      "explorer.openEditors.visible": 0,
      "explorer.sortOrder": "type",
      "explorer.sortOrderLexicographicOptions": "upper",
      "explorer.compactFolders": true,
      "explorer.confirmDelete": false,
      "explorer.confirmDragAndDrop": false,
      "explorer.enableDragAndDrop": true,
      "explorer.decorateFolders": true,
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.expand": false,
      "explorer.fileNesting.patterns": {
        "*.ts": "$(capture).test.ts, $(capture).spec.ts, $(capture).d.ts",
        "*.tsx": "$(capture).test.tsx, $(capture).spec.tsx",
        "*.js": "$(capture).test.js, $(capture).spec.js, $(capture).d.js",
        "*.jsx": "$(capture).test.jsx, $(capture).spec.jsx",
        "*.css": "$(capture).module.css",
        "*.scss": "$(capture).module.scss",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .npmrc, .yarnrc, .pnpmfile.cjs",
        "tsconfig.json": "tsconfig.*.json",
        ".env": ".env.*, env.d.ts",
        "README.md": "CHANGELOG.md, LICENSE*, CONTRIBUTING.md, CODE_OF_CONDUCT.md"
      },
      "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/dist": true,
        "**/build": true,
        "**/out": true,
        "**/.next": true,
        "**/.nuxt": true,
        "**/coverage": true,
        "**/.cache": true,
        "**/vendor": true,
        "**/*.min.js": true,
        "**/*.min.css": true
      },
      "search.searchOnType": true,
      "search.searchOnTypeDebouncePeriod": 300,
      "search.showLineNumbers": true,
      "search.useIgnoreFiles": true,
      "search.useGlobalIgnoreFiles": true,
      "search.useParentIgnoreFiles": true,
      "search.mode": "view",
      "search.smartCase": true,
      "breadcrumbs.enabled": true,
      "breadcrumbs.filePath": "on",
      "breadcrumbs.symbolPath": "on",
      "breadcrumbs.symbolSortOrder": "type",
      "files.autoSave": "afterDelay",
      "files.autoSaveDelay": 1000,
      "files.trimTrailingWhitespace": true,
      "files.insertFinalNewline": true,
      "files.trimFinalNewlines": true,
      "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/.hg/store/**": true,
        "**/dist/**": true,
        "**/.next/**": true
      },
      "files.defaultLanguage": "",
      "files.eol": "\n",
      "emmet.includeLanguages": {
        "javascript": "javascriptreact",
        "typescript": "typescriptreact",
        "vue-html": "html",
        "razor": "html",
        "plaintext": "html"
      },
      "emmet.triggerExpansionOnTab": true,
      "emmet.showExpandedAbbreviation": "always",
      "emmet.showSuggestionsAsSnippets": true,
      "git.enabled": true,
      "git.autofetch": true,
      "git.confirmSync": false,
      "git.enableSmartCommit": true,
      "git.smartCommitChanges": "all",
      "git.postCommitCommand": "none",
      "git.showInlineOpenFileAction": false,
      "git.decorations.enabled": true,
      "git.blame.editorDecoration.enabled": true,
      "scm.defaultViewMode": "tree",
      "scm.diffDecorations": "all",
      "scm.diffDecorationsGutterWidth": 3,
      "debug.internalConsoleOptions": "neverOpen",
      "debug.console.closeOnEnd": false,
      "debug.showInStatusBar": "onFirstSession",
      "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', monospace",
      "terminal.integrated.fontSize": 13,
      "terminal.integrated.lineHeight": 1.3,
      "terminal.integrated.cursorStyle": "line",
      "terminal.integrated.cursorBlinking": true,
      "terminal.integrated.scrollback": 10000,
      "terminal.integrated.smoothScrolling": true,
      "terminal.integrated.enableBell": false,
      "terminal.integrated.defaultProfile.linux": "bash",
      "terminal.integrated.defaultProfile.osx": "zsh",
      "terminal.integrated.defaultProfile.windows": "PowerShell",
      "terminal.integrated.tabs.enabled": true,
      "terminal.integrated.tabs.showActiveTerminal": "single",
      "terminal.integrated.showExitAction": "never",
      "explorer.openEditors.visible": 0,
      "explorer.sortOrder": "type",
      "explorer.sortOrderLexicographicOptions": "upper",
      "explorer.compactFolders": true,
      "explorer.confirmDelete": false,
      "explorer.confirmDragAndDrop": false,
      "explorer.enableDragAndDrop": true,
      "explorer.decorateFolders": true,
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.expand": false,
      "explorer.fileNesting.patterns": {
        "*.ts": "$(capture).test.ts, $(capture).spec.ts, $(capture).d.ts",
        "*.tsx": "$(capture).test.tsx, $(capture).spec.tsx",
        "*.js": "$(capture).test.js, $(capture).spec.js, $(capture).d.js",
        "*.jsx": "$(capture).test.jsx, $(capture).spec.jsx",
        "*.css": "$(capture).module.css",
        "*.scss": "$(capture).module.scss",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .npmrc, .yarnrc, .pnpmfile.cjs",
        "tsconfig.json": "tsconfig.*.json",
        ".env": ".env.*, env.d.ts",
        "README.md": "CHANGELOG.md, LICENSE*, CONTRIBUTING.md, CODE_OF_CONDUCT.md"
      },
      "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/dist": true,
        "**/build": true,
        "**/out": true,
        "**/.next": true,
        "**/.nuxt": true,
        "**/coverage": true,
        "**/.cache": true,
        "**/vendor": true,
        "**/*.min.js": true,
        "**/*.min.css": true
      },
      "search.searchOnType": true,
      "search.searchOnTypeDebouncePeriod": 300,
      "search.showLineNumbers": true,
      "search.useIgnoreFiles": true,
      "search.useGlobalIgnoreFiles": true,
      "search.useParentIgnoreFiles": true,
      "search.mode": "view",
      "search.smartCase": true,
      "breadcrumbs.enabled": true,
      "breadcrumbs.filePath": "on",
      "breadcrumbs.symbolPath": "on",
      "breadcrumbs.symbolSortOrder": "type",
      "files.autoSave": "afterDelay",
      "files.autoSaveDelay": 1000,
      "files.trimTrailingWhitespace": true,
      "files.insertFinalNewline": true,
      "files.trimFinalNewlines": true,
      "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/.hg/store/**": true,
        "**/dist/**": true,
        "**/.next/**": true
      },
      "files.defaultLanguage": "",
      "files.eol": "\n",
      "emmet.includeLanguages": {
        "javascript": "javascriptreact",
        "typescript": "typescriptreact",
        "vue-html": "html",
        "razor": "html",
        "plaintext": "html"
      },
      "emmet.triggerExpansionOnTab": true,
      "emmet.showExpandedAbbreviation": "always",
      "emmet.showSuggestionsAsSnippets": true,
      "git.enabled": true,
      "git.autofetch": true,
      "git.confirmSync": false,
      "git.enableSmartCommit": true,
      "git.smartCommitChanges": "all",
      "git.postCommitCommand": "none",
      "git.showInlineOpenFileAction": false,
      "git.decorations.enabled": true,
      "git.blame.editorDecoration.enabled": true,
      "scm.defaultViewMode": "tree",
      "scm.diffDecorations": "all",
      "scm.diffDecorationsGutterWidth": 3,
      "debug.internalConsoleOptions": "neverOpen",
      "debug.console.closeOnEnd": false,
      "debug.showInStatusBar": "onFirstSession",
      "debug.toolBarLocation": "docked",
      "debug.saveBeforeStart": "nonEditors",
      "zenMode.fullScreen": true,
      "zenMode.centerLayout": true,
      "zenMode.showTabs": "multiple",
      "zenMode.hideStatusBar": true,
      "zenMode.hideActivityBar": true,
      "zenMode.hideLineNumbers": false,
      "zenMode.restore": true,
      "zenMode.silentNotifications": true,
      "extensions.ignoreRecommendations": false,
      "extensions.showRecommendedExtensionsOnly": false,
      "redhat.telemetry.enabled": false,
      "terminal.integrated.gpuAcceleration": "auto",
      "editor.largeFileOptimizations": true,
      "files.maxMemoryForLargeFilesMB": 4096,
      "notifications.doNotDisturbMode": false,
      "problems.visibility": true,
      "problems.autoReveal": true,
      "problems.decorations.enabled": true
    }
  }
}
